generator client {
  provider = "prisma-client"
  output   = "../../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  name          String
  email         String
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  ownedBudgets  Budget[]       @relation("BudgetOwner")
  memberships   BudgetMember[]
  settings      UserSettings?
  mailEvents    EmailOutbox[]
  tutorial      TutorialProgress?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@index([lastRequest])
  @@map("rateLimit")
}

enum MemberRole {
  EDITOR
  VIEWER
}

enum MailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model Budget {
  id                  String         @id @default(cuid())
  name                String         @db.VarChar(80)
  currency            String         @default("NGN") @db.Char(3)
  timezone            String         @default("Africa/Lagos") @db.VarChar(64)
  ownerUserId         String
  creatorUserId       String
  owner               User           @relation("BudgetOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  requestId           String         @db.Uuid
  creationFingerprint String
  members             BudgetMember[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  archivedAt          DateTime?
  moneyRevision       Int            @default(0)
  quickBudgetSplits   Json           @default("[]")
  isPractice          Boolean        @default(false)
  tutorial            TutorialProgress?
  moneyAccounts       MoneyAccount[]
  categories          BudgetCategory[]
  transactions        MoneyTransaction[]
  assignments         BudgetAssignment[]
  moneyOperations     MoneyOperation[]
  categoryGroups      CategoryGroup[]
  categoryTargets     CategoryTarget[]
  invitations         BudgetInvitation[]
  sharingRevision     Int            @default(0)

  @@unique([creatorUserId, requestId])
  @@index([ownerUserId])
}

enum MoneyKind {
  OPENING
  INCOME
  EXPENSE
  TRANSFER
  REFUND
}

enum MoneyAccountKind {
  BANK
  SAVINGS
  CASH
}

model MoneyAccount {
  id        String           @id @default(cuid())
  budgetId  String
  budget    Budget           @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  name      String           @db.VarChar(80)
  kind      MoneyAccountKind
  version   Int              @default(1)
  closedAt  DateTime?
  createdAt DateTime         @default(now())
  entries   MoneyEntry[]

  @@unique([budgetId, id])
  @@index([budgetId, createdAt])
}

model BudgetCategory {
  id          String             @id @default(cuid())
  budgetId    String
  budget      Budget             @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  name        String             @db.VarChar(80)
  note        String             @default("") @db.VarChar(1000)
  groupId     String?
  group       CategoryGroup?     @relation(fields: [budgetId, groupId], references: [budgetId, id], onDelete: Restrict)
  sortOrder   Int                @default(0)
  version     Int                @default(1)
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  transactions MoneyTransaction[]
  assignments BudgetAssignment[]
  target      CategoryTarget?

  @@unique([budgetId, id])
  @@index([budgetId, createdAt])
  @@index([budgetId, groupId, sortOrder])
}

model CategoryGroup {
  id         String           @id @default(cuid())
  budgetId   String
  budget     Budget           @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  name       String           @db.VarChar(80)
  note       String           @default("") @db.VarChar(1000)
  sortOrder  Int              @default(0)
  version    Int              @default(1)
  archivedAt DateTime?
  createdAt  DateTime         @default(now())
  categories BudgetCategory[]

  @@unique([budgetId, id])
  @@index([budgetId, sortOrder])
}

enum TargetKind {
  MONTHLY
  BY_DATE
}

model CategoryTarget {
  id         String         @id @default(cuid())
  budgetId   String
  budget     Budget         @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  categoryId String
  category   BudgetCategory @relation(fields: [budgetId, categoryId], references: [budgetId, id], onDelete: Restrict)
  kind       TargetKind
  amount     Decimal        @db.Decimal(20, 2)
  startMonth DateTime       @db.Date
  dueDate    DateTime?      @db.Date
  version    Int            @default(1)
  removedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([budgetId, categoryId])
}

model MoneyTransaction {
  id         String          @id @default(cuid())
  budgetId   String
  budget     Budget          @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  kind       MoneyKind
  date       DateTime        @db.Date
  categoryId String?
  category   BudgetCategory? @relation(fields: [budgetId, categoryId], references: [budgetId, id], onDelete: Restrict)
  memo       String          @default("") @db.VarChar(240)
  payee      String          @default("") @db.VarChar(100)
  version    Int             @default(1)
  voidedAt   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  entries    MoneyEntry[]

  @@unique([budgetId, id])
  @@index([budgetId, date, id])
}

model MoneyEntry {
  id            String           @id @default(cuid())
  budgetId      String
  transactionId String
  transaction   MoneyTransaction @relation(fields: [budgetId, transactionId], references: [budgetId, id], onDelete: Restrict)
  accountId     String
  account       MoneyAccount     @relation(fields: [budgetId, accountId], references: [budgetId, id], onDelete: Restrict)
  position      Int
  amount        Decimal          @db.Decimal(20, 2)

  @@unique([transactionId, position])
  @@index([budgetId, accountId, transactionId])
}

model BudgetAssignment {
  id         String         @id @default(cuid())
  budgetId   String
  budget     Budget         @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  categoryId String
  category   BudgetCategory @relation(fields: [budgetId, categoryId], references: [budgetId, id], onDelete: Restrict)
  month      DateTime       @db.Date
  amount     Decimal        @db.Decimal(20, 2)

  @@unique([budgetId, categoryId, month])
  @@index([budgetId, month])
}

model MoneyOperation {
  id          String   @id @default(cuid())
  budgetId    String
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  actorUserId String
  requestId   String   @db.Uuid
  action      String   @db.VarChar(32)
  fingerprint String
  result      Json
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@unique([budgetId, requestId])
  @@index([budgetId, createdAt, id])
}

model BudgetMember {
  id       String     @id @default(cuid())
  budgetId String
  userId   String
  role     MemberRole
  version  Int        @default(1)
  budget   Budget     @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@unique([budgetId, userId])
  @@index([userId])
}

model BudgetInvitation {
  id             String     @id @default(cuid())
  budgetId       String
  budget         Budget     @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  email          String     @db.VarChar(254)
  role           MemberRole
  ownership      Boolean    @default(false)
  tokenHash      String     @unique @db.Char(64)
  createdById    String
  expiresAt      DateTime
  revokedAt      DateTime?
  acceptedAt     DateTime?
  acceptedUserId String?
  delivery       MailStatus @default(PENDING)
  createdAt      DateTime   @default(now())

  @@index([budgetId, createdAt])
}

model UserSettings {
  userId           String    @id
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastBudgetId     String?
  setupCompletedAt DateTime?
  updatedAt        DateTime  @updatedAt
}

enum TutorialStatus {
  ACTIVE
  SKIPPED
  COMPLETED
}

model TutorialProgress {
  userId           String         @id
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           TutorialStatus @default(ACTIVE)
  practiceBudgetId String?        @unique
  practiceBudget   Budget?        @relation(fields: [practiceBudgetId], references: [id], onDelete: SetNull)
  practiceDate     DateTime?      @db.Date
  lesson           Int            @default(1)
  challenge        Boolean        @default(false)
  version          Int            @default(0)
  lastRequestId    String?        @db.Uuid
  lastAction       String?
  lastDestination  String?
  startedAt        DateTime?
  firstActionAt    DateTime?
  completedAt      DateTime?
  updatedAt        DateTime       @updatedAt
}

model EmailOutbox {
  id            String     @id @default(cuid())
  eventKey      String     @unique
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        MailStatus @default(PENDING)
  attempts      Int        @default(0)
  nextAttemptAt DateTime   @default(now())
  sentAt        DateTime?
  createdAt     DateTime   @default(now())

  @@index([status, nextAttemptAt])
}

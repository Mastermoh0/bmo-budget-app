      "description": "Filled action with immediate pressed and focus feedback.",
      "html": "<button class=\"ds-button\">Assign money</button>",
      "css": ".ds-button{font-family:Manrope,system-ui,sans-serif;position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:40px;width:fit-content;max-width:100%;padding:10px 16px;border:1px solid var(--primary,#233b55);border-radius:6px;background:var(--primary,#233b55);color:var(--on-primary,#fff);font-size:13px;font-weight:750;text-decoration:none;cursor:pointer;transition:background 160ms ease-out,box-shadow 160ms ease-out,transform 100ms ease-out}.ds-button:hover{background:var(--accent,#285fb5);border-color:var(--accent,#285fb5);color:var(--on-primary,#fff)}.ds-button:active{transform:translateY(1px);box-shadow:inset 0 2px 4px #0003}.ds-button:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-button:disabled{opacity:.6;cursor:not-allowed;transform:none;box-shadow:none}.ds-button[aria-busy=true]{opacity:.85;cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}",
      "refersTo": "button-primary-light"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "description": "Outlined action used for secondary and account controls.",
      "html": "<button class=\"ds-button ds-secondary\">Sign out all devices</button>",
      "css": ".ds-button{font-family:Manrope,system-ui,sans-serif;position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:40px;width:fit-content;max-width:100%;padding:10px 16px;border:1px solid var(--primary,#233b55);border-radius:6px;background:var(--primary,#233b55);color:var(--on-primary,#fff);font-size:13px;font-weight:750;text-decoration:none;cursor:pointer;transition:background 160ms ease-out,box-shadow 160ms ease-out,transform 100ms ease-out}.ds-button:hover{background:var(--accent,#285fb5);border-color:var(--accent,#285fb5);color:var(--on-primary,#fff)}.ds-button:active{transform:translateY(1px);box-shadow:inset 0 2px 4px #0003}.ds-button:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-button:disabled{opacity:.6;cursor:not-allowed;transform:none;box-shadow:none}.ds-button[aria-busy=true]{opacity:.85;cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{background:var(--surface,#fff);color:var(--text,#233b55);border-color:var(--control,#7389a3)}.ds-secondary:hover{background:var(--raised,#f4f7fb);color:var(--text,#233b55);border-color:var(--text,#233b55)}",
      "refersTo": "button-secondary-light"
    },
    {
      "name": "Danger action",
      "kind": "button",
      "description": "The implemented danger variant; keep explicit action wording.",
      "html": "<button class=\"ds-button ds-danger\">Revoke access</button>",
      "css": ".ds-button{font-family:Manrope,system-ui,sans-serif;position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:40px;width:fit-content;max-width:100%;padding:10px 16px;border:1px solid var(--primary,#233b55);border-radius:6px;background:var(--primary,#233b55);color:var(--on-primary,#fff);font-size:13px;font-weight:750;text-decoration:none;cursor:pointer;transition:background 160ms ease-out,box-shadow 160ms ease-out,transform 100ms ease-out}.ds-button:hover{background:var(--accent,#285fb5);border-color:var(--accent,#285fb5);color:var(--on-primary,#fff)}.ds-button:active{transform:translateY(1px);box-shadow:inset 0 2px 4px #0003}.ds-button:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-button:disabled{opacity:.6;cursor:not-allowed;transform:none;box-shadow:none}.ds-button[aria-busy=true]{opacity:.85;cursor:progress}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-danger{background:var(--negative,#a52e3a);color:var(--surface,#fff);border-color:var(--negative,#a52e3a)}"
    },
    {
      "name": "Labelled field",
      "kind": "input",
      "description": "Visible label and a distinct control boundary.",
      "html": "<label class=\"ds-label\">Amount (NGN)<input class=\"ds-input\" inputmode=\"decimal\" placeholder=\"0.00\" /></label>",
      "css": ".ds-label{font-family:Manrope,system-ui,sans-serif;display:grid;gap:7px;font-size:13px;font-weight:650;color:var(--text,#233b55)}.ds-input{font-family:Manrope,system-ui,sans-serif;width:100%;min-width:0;padding:10px 12px;border:1px solid var(--control,#7389a3);border-radius:6px;color:var(--text,#233b55);background:var(--surface,#fff);min-height:42px;caret-color:var(--accent,#285fb5)}.ds-input::placeholder{color:var(--muted,#506782);opacity:1}.ds-input[readonly]{background:var(--raised,#f4f7fb)}.ds-input:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}",
      "refersTo": "input-light"
    },
    {
      "name": "Budget navigation",
      "kind": "nav",
      "description": "Current page is explicit; pending dots supplement route loading.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Budget\"><a href=\"#budget\" aria-current=\"page\">Budget</a><a href=\"#transactions\">Transactions<span class=\"ds-hint\" aria-hidden=\"true\"></span></a><a href=\"#reports\">Reports</a></nav>",
      "css": ".ds-nav{font-family:Manrope,system-ui,sans-serif;display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:0 0 28px;border-bottom:1px solid var(--line,#dbe4ef);padding:0 0 14px;color:var(--text,#233b55)}.ds-nav a{font-size:12px;text-decoration:none;padding:8px 12px;border-radius:5px;position:relative;color:inherit}.ds-nav a:hover{background:var(--raised,#f4f7fb);color:var(--accent,#285fb5)}.ds-nav a[aria-current=page]{background:var(--active,#e6edf6);color:var(--text,#233b55);font-weight:800}.ds-nav a:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-hint{display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--accent,#285fb5);opacity:0;margin-left:5px}.ds-hint.ds-pending{opacity:1;animation:ds-nav-pulse 1.2s ease-in-out infinite}@keyframes ds-nav-pulse{0%,100%{opacity:1}50%{opacity:.5}}@media(prefers-reduced-motion:reduce){.ds-hint{animation:none}}"
    },
    {
      "name": "Status tag",
      "kind": "chip",
      "description": "A noninteractive role/archive label.",
      "html": "<span class=\"ds-status\">OWNER</span>",
      "css": ".ds-status{font-family:Manrope,system-ui,sans-serif;display:inline-flex;align-items:center;background:var(--raised,#f4f7fb);color:var(--muted,#506782);font-size:11px;font-weight:650;padding:3px 8px;border-radius:5px;vertical-align:middle}",
      "refersTo": "status-light"
    },
    {
      "name": "Open section",
      "kind": "card",
      "description": "The implemented container uses a top divider rather than a resting shadow.",
      "html": "<section class=\"ds-panel\"><h2>Profile</h2><p>Keep your display name up to date.</p></section>",
      "css": ".ds-panel{font-family:Manrope,system-ui,sans-serif;padding:26px 0;margin:12px 0 0;border-top:1px solid var(--line,#dbe4ef);min-width:0;color:var(--text,#233b55)}.ds-panel h2{line-height:1.35;font-size:17px;letter-spacing:-.02em;font-weight:750;margin:0 0 16px}.ds-panel p{margin:8px 0 0;max-width:76ch;font-size:14px;line-height:1.6}"
    },
    {
      "name": "Purpose category",
      "kind": "custom",
      "description": "Native disclosure preserves context while exposing exact breakdown; figures here are explicitly demo-only.",
      "html": "<details class=\"ds-purpose\"><summary><span class=\"ds-name\">Groceries<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\" /></svg></span><span class=\"ds-figure\"><strong>₦0.00</strong><small>available</small></span><span class=\"ds-bar\" aria-hidden=\"true\"><span></span></span><span class=\"ds-caption\">View details · demonstration only</span></summary><dl class=\"ds-breakdown\"><div><dt>Available</dt><dd>₦0.00</dd></div></dl></details>",
      "css": ".ds-purpose{font-family:Manrope,system-ui,sans-serif;min-width:0;padding:0;border-bottom:1px solid var(--line,#dbe4ef);color:var(--text,#233b55)}.ds-purpose summary{list-style:none;padding:20px 0;display:grid;gap:14px;font-weight:500;cursor:pointer}.ds-purpose summary::-webkit-details-marker{display:none}.ds-purpose summary:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-name{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:13px}.ds-name svg{width:15px;height:15px;stroke:var(--muted,#506782);fill:none;stroke-width:1.5}.ds-purpose[open] .ds-name svg{transform:rotate(90deg)}.ds-figure{display:flex;align-items:baseline;justify-content:space-between;gap:10px}.ds-figure strong{font-size:24px;line-height:1.4;font-weight:650;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-figure small{font-size:10px;color:var(--muted,#506782)}.ds-bar{height:4px;background:var(--active,#e6edf6);border-radius:4px;overflow:hidden}.ds-bar>span{display:block;height:100%;width:0;background:var(--accent,#285fb5);border-radius:inherit}.ds-caption{font-size:11px;color:var(--muted,#506782)}.ds-breakdown{margin:0 0 16px}.ds-breakdown div{display:flex;justify-content:space-between;gap:12px;padding:5px 0;font-size:12px}.ds-breakdown dd{margin:0;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Appearance switch",
      "kind": "custom",
      "description": "Visual specimen of the implemented switch; runtime React performs persistence and root theme updates.",
      "html": "<button type=\"button\" class=\"ds-appearance\" role=\"switch\" aria-checked=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 14A8 8 0 0 1 10 4a8 8 0 1 0 10 10Z\" /></svg>Dark mode<span class=\"ds-track\" aria-hidden=\"true\"><span></span></span></button>",
      "css": ".ds-appearance{font-family:Manrope,system-ui,sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 12px;border:1px solid var(--control,#7389a3);border-radius:6px;background:var(--surface,#fff);color:var(--text,#233b55);min-width:142px;min-height:40px;font-size:12px;font-weight:750;cursor:pointer}.ds-appearance:hover{background:var(--raised,#f4f7fb);border-color:var(--text,#233b55)}.ds-appearance:active{transform:translateY(1px);box-shadow:inset 0 2px 4px #0003}.ds-appearance:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-appearance svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5}.ds-track{width:24px;height:14px;border-radius:12px;padding:3px;background:var(--control,#7389a3);display:block}.ds-track>span{width:8px;height:8px;border-radius:50%;display:block;background:var(--surface,#fff);transition:transform 180ms cubic-bezier(.16,1,.3,1)}.ds-appearance[aria-checked=true] .ds-track{background:var(--accent,#285fb5)}.ds-appearance[aria-checked=true] .ds-track>span{transform:translateX(10px);background:var(--ground,#eaf0f6)}@media(prefers-reduced-motion:reduce){.ds-track>span{transition:none}}"
    },
    {
      "name": "Route skeleton",
      "kind": "custom",
      "description": "One status announcement with decorative placeholders; no invented balance.",
      "html": "<div class=\"ds-skeleton\" role=\"status\" aria-busy=\"true\" aria-label=\"Loading settings\"><span class=\"ds-sr\">Loading settings. Your information will appear here.</span><div aria-hidden=\"true\"><div class=\"ds-block ds-title\"></div><div class=\"ds-block ds-subtitle\"></div><div class=\"ds-section\"><div class=\"ds-block ds-field\"></div><div class=\"ds-block ds-field\"></div></div></div></div>",
      "css": ".ds-skeleton{min-height:480px}.ds-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}.ds-block{background:var(--active,#e6edf6);border-radius:4px;min-height:14px;animation:ds-skeleton-pulse 1.5s ease-in-out infinite}.ds-title{height:32px;width:250px;max-width:65vw;margin-bottom:12px}.ds-subtitle{width:200px;max-width:65vw;height:16px}.ds-section{padding-block:24px;border-top:1px solid var(--line,#dbe4ef);margin-top:28px}.ds-field{width:100%;height:40px;margin-top:28px}@keyframes ds-skeleton-pulse{0%,100%{opacity:1}50%{opacity:.5}}@media(prefers-reduced-motion:reduce){.ds-block{animation:none}}"
    },
    {
      "name": "Task window",
      "kind": "custom",
      "refersTo": "task-window-light",
      "description": "Static open Assign money specimen from the implemented native task window; both themes share geometry. Application code supplies modal behavior and safe original-request retry.",
      "html": "<dialog open class=\"ds-task-window\" aria-labelledby=\"ds-task-title\"><div class=\"ds-task-heading\"><h2 id=\"ds-task-title\" tabindex=\"-1\">Assign money</h2><button type=\"button\" class=\"ds-task-button ds-task-secondary ds-task-close\" aria-label=\"Close assign money\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m6 6 12 12M18 6 6 18\" /></svg></button></div><div class=\"ds-task-content\"><label class=\"ds-task-label\">Category<select class=\"ds-task-field\" name=\"categoryId\" required><option value=\"\">Choose a category</option></select></label><label class=\"ds-task-label\">Amount (NGN)<input class=\"ds-task-field\" name=\"amount\" inputmode=\"decimal\" placeholder=\"0.00\" required /></label><p class=\"ds-task-small\">A positive amount assigns money. A negative amount returns available money.</p><button type=\"button\" class=\"ds-task-button\">Assign money</button></div><div class=\"ds-task-footer\"><button type=\"button\" class=\"ds-task-button ds-task-secondary\">Cancel</button></div></dialog>",
      "css": ".ds-task-window{position:relative;margin:0 auto;font-family:Manrope,system-ui,sans-serif;font-size:14px;line-height:1.6;width:min(640px,calc(100vw - 32px));max-height:calc(100dvh - 40px);padding:28px;border:1px solid var(--control,#7389a3);border-radius:12px;background:var(--surface,#fff);color:var(--text,#233b55);box-shadow:0 18px 64px #0003;overflow:auto}.ds-task-window::backdrop{background:#10182066}.ds-task-heading{display:flex;align-items:start;justify-content:space-between;gap:20px;margin-bottom:24px}.ds-task-heading h2{font-size:22px;font-weight:750;line-height:1.35;letter-spacing:-.02em;margin:4px 0 0;text-wrap:balance}.ds-task-heading h2:focus{outline:none}.ds-task-content{display:grid;gap:16px;min-width:0}.ds-task-label{display:grid;gap:7px;font-size:13px;font-weight:650;min-width:0}.ds-task-field{font:inherit;width:100%;min-width:0;min-height:42px;padding:10px 12px;border:1px solid var(--control,#7389a3);border-radius:6px;color:var(--text,#233b55);background:var(--surface,#fff);caret-color:var(--accent,#285fb5)}.ds-task-field::placeholder{color:var(--muted,#506782);opacity:1}.ds-task-small{font-size:12px;line-height:1.65;color:var(--muted,#506782);margin:8px 0 16px;max-width:76ch}.ds-task-button{font-family:inherit;position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:40px;width:fit-content;max-width:100%;padding:10px 16px;border:1px solid var(--primary,#233b55);border-radius:6px;background:var(--primary,#233b55);color:var(--on-primary,#fff);font-size:13px;font-weight:750;cursor:pointer;transition:background 160ms ease-out,box-shadow 160ms ease-out,transform 100ms ease-out}.ds-task-button:hover{background:var(--accent,#285fb5);border-color:var(--accent,#285fb5);color:var(--on-primary,#fff)}.ds-task-button:active{transform:translateY(1px);box-shadow:inset 0 2px 4px #0003}.ds-task-button:focus-visible,.ds-task-field:focus-visible{outline:3px solid var(--accent,#285fb5);outline-offset:4px}.ds-task-button:disabled{opacity:.6;cursor:not-allowed;transform:none;box-shadow:none}.ds-task-button[aria-busy=true]{opacity:.85;cursor:progress}.ds-task-secondary{background:var(--surface,#fff);color:var(--text,#233b55);border-color:var(--control,#7389a3)}.ds-task-secondary:hover{background:var(--raised,#f4f7fb);color:var(--text,#233b55);border-color:var(--text,#233b55)}.ds-task-close{width:36px;min-height:36px;padding:8px;flex:none}.ds-task-close svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8}.ds-task-footer{display:flex;align-items:center;gap:16px;border-top:1px solid var(--line,#dbe4ef);margin-top:24px;padding-top:18px}@media(max-width:650px){.ds-task-window{padding:22px 18px;max-height:calc(100dvh - 24px);width:calc(100vw - 20px)}.ds-task-field{font-size:16px}.ds-task-footer{flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.ds-task-button{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Canvas / Night Desk",
    "overview": "An open workspace gives available money a purpose. Canvas surrounds a white inset surface with a cool blue frame; Night Desk brings the same geometry into charcoal, warm text and amber. Manrope, fine dividers and spacious purpose groups make a working budget feel ordered and approachable.\n\nThe interface is built from the accepted Canvas prototype, with runtime records supplying every financial figure. Colour changes carry through navigation, forms, reports and security settings without changing the user's place or financial work. The authored Bimo mark and self-hosted typeface supply the identity; external imagery is not part of this implementation.",
    "keyCharacteristics": [
      "A framed workspace with top navigation and a quiet footer.",
      "Open, divided sections and grouped purposes with expandable financial details.",
      "Exact NGN figures, tabular numerals and visible status language.",
      "Shared geometry across light and dark appearances.",
      "Immediate pending feedback, structural loading placeholders and recoverable errors."
    ],
    "rules": [
      {
        "name": "The Shared Geometry Rule",
        "body": "Change appearance through the role tokens; keep layout, information order and form state intact.",
        "section": "colors"
      },
      {
        "name": "The Exact Figures Rule",
        "body": "Use formatted runtime NGN values with two decimal places and tabular numerals in financial figures, tables and breakdowns. Placeholder blocks carry no sample balances.",
        "section": "typography"
      },
      {
        "name": "The Open Surface Rule",
        "body": "Preserve the existing open sections and divider-based purpose groups when extending these screens; do not turn them into a stack of elevated cards.",
        "section": "elevation & depth"
      }
    ],
    "dos": [
      "**Do** use the existing semantic colour roles for both appearances and preserve shared geometry.",
      "**Do** show exact runtime balances and distinguish overspending with words as well as colour.",
      "**Do** retain work during asynchronous actions and explain what a retry will send.",
      "**Do** pair decorative loading with one accessible status and honour reduced motion.",
      "**Do** reuse the self-hosted Manrope face and authored inline Bimo mark."
    ],
    "donts": [
      "**Don't** copy fixture amounts from a prototype or review screenshot into product defaults.",
      "**Don't** replace open purpose groups with elevated card stacks on these screens.",
      "**Don't** remove visible field labels, keyboard focus or textual error guidance.",
      "**Don't** imply an unavailable provider, mailbox connection or account-deletion feature is ready.",
      "**Don't** describe the narrow fallback as the separately planned mobile composition."
    ]
  }
}

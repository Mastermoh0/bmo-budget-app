{
  "name": "budget-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --port 3100 --hostname 127.0.0.1",
    "local:setup": "node scripts/setup-local.mjs",
    "build": "prisma generate && next build --webpack",
    "start": "next start --port 3100 --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/check-database-target.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/check-database-target.ts && prisma migrate deploy",
    "test": "node scripts/run-integration.mjs",
    "mail:retry": "tsx scripts/retry-welcome.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.14",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.14",
    "dotenv": "17.2.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.14",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jiti": "2.7.0",
    "prisma": "7.10.1",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "24.x"
  }
}
